# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/email_scheduler"

# --- Redis (matches docker-compose.yml redis service) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Worker tuning (all configurable — nothing hardcoded) ---
# How many jobs the worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum gap enforced between any two emails leaving the queue (ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Fallback global hourly cap if a campaign doesn't set its own hourlyLimit
MAX_EMAILS_PER_HOUR_GLOBAL=500

# --- Google OAuth (Google Cloud Console -> OAuth 2.0 Client ID, Web application) ---
GOOGLE_CLIENT_ID="add your client id"
GOOGLE_CLIENT_SECRET="add your client secret"
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- JWT used to sign the app's own session token after Google login ---
JWT_SECRET=change-me-to-something-random
