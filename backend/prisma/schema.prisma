generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING   // created in DB, not yet enqueued to BullMQ
  QUEUED    // enqueued in BullMQ, waiting for its delay to elapse
  SENT
  FAILED
  RESCHEDULED // hit rate limit, pushed to a later window
}

model Sender {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  // Ethereal (or any SMTP) credentials for this sender identity
  smtpHost           String
  smtpPort           Int
  smtpUser           String
  smtpPass           String
  maxEmailsPerHour   Int      @default(200)
  createdAt          DateTime @default(now())

  emailJobs          EmailJob[]
}

model Campaign {
  id                    String   @id @default(uuid())
  subject               String
  body                  String   @db.Text
  startTime             DateTime
  delayBetweenEmailsMs  Int      @default(2000)
  hourlyLimit           Int      @default(200)
  createdAt             DateTime @default(now())

  emailJobs             EmailJob[]
}

model EmailJob {
  id               String    @id @default(uuid())
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId         String
  sender           Sender    @relation(fields: [senderId], references: [id])

  recipientEmail   String
  subject          String
  body             String    @db.Text

  scheduledFor     DateTime
  status           JobStatus @default(PENDING)

  // BullMQ job id — lets us look up / dedupe against the queue itself
  bullJobId        String?   @unique

  // Guarantees the same (campaign, recipient) pair is never enqueued twice,
  // even if the API is called multiple times or the worker retries a batch.
  idempotencyKey   String    @unique

  attempts         Int       @default(0)
  lastError        String?
  sentAt           DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([campaignId])
  @@index([senderId, scheduledFor])
}
